<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- INTERNET is used only to send TEXT (on-device transcripts) to Gemini Flash Lite.
         Microphone audio and users' recordings are never transmitted. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required on Android 11+ so SpeechRecognizer can bind to the on-device
         speech recognition service for local (offline) transcription. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- allowBackup is deliberately FALSE. Android Auto Backup would copy the user's
         voice recordings (filesDir/audio_clips) and the clip database to their Google
         Drive, which would contradict the app's core promise that recordings never
         leave the device. Users move their data explicitly via Settings → Export
         backup instead. The rules files below also exclude the audio and database, so
         nothing sensitive is uploaded even if backup is ever re-enabled. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Repeatless">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Repeatless">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".widget.AudioPlaybackService"
            android:exported="false" />

        <receiver
            android:name=".widget.SoundboardWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soundboard_widget_info" />
        </receiver>
    </application>

</manifest>
