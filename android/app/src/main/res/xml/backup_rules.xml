<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for devices BELOW API 31 (see data_extraction_rules.xml for API 31+).

   android:allowBackup is "false" in AndroidManifest.xml, so nothing is backed up at
   all. These exclusions are defence-in-depth: if backup is ever re-enabled, the
   user's voice recordings and clip database must still never be uploaded, because
   "your recordings never leave your phone" is the product's core promise.
-->
<full-backup-content>
    <!-- Voice recordings live in filesDir/audio_clips -->
    <exclude domain="file" path="audio_clips" />
    <!-- Room database holding boards, clip labels and file references -->
    <exclude domain="database" path="soundboard.db" />
    <exclude domain="database" path="soundboard.db-shm" />
    <exclude domain="database" path="soundboard.db-wal" />
    <!-- DataStore holds the PRO entitlement; it must be re-derived from Play, not restored -->
    <exclude domain="file" path="datastore" />
</full-backup-content>
