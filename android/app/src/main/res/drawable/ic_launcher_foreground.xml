<?xml version="1.0" encoding="utf-8"?>
<!-- Repeatless launcher mark: a coral soundboard pad with the "say it once"
     glyph — a bold numeral 1 followed by sound waves (see docs/BRAND.md). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Coral pad -->
    <path
        android:fillColor="#FF5147"
        android:pathData="M42,30 h24 a12,12 0 0 1 12,12 v24 a12,12 0 0 1 -12,12 h-24 a12,12 0 0 1 -12,-12 v-24 a12,12 0 0 1 12,-12 z" />

    <!-- Numeral 1: stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,40 h6.5 v28 h-6.5 z" />
    <!-- Numeral 1: flag -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,40 L39.5,44.5 L39.5,51 L46,46.5 Z" />

    <!-- Sound waves -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M58.5,47 A9,9 0 0 1 58.5,61" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M64,42.5 A15,15 0 0 1 64,65.5" />
</vector>
